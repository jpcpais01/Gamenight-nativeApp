<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The match engine: a plain C# library with no Godot types, a port of the PWA's src/sim.
    Same rules, numbers and seeded RNG as the PWA, so the same seed plays the same match.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>GameNight.Sim</RootNamespace>
    <AssemblyName>GameNight.Sim</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>
</Project>
